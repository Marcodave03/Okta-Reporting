# ---------- App ----------
APP_BASE_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars
TZ=Asia/Jakarta

# Akun admin awal (dibuat otomatis saat pertama kali start)
ADMIN_EMAIL=admin@iga.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=IGA Administrator

# Isi data demo otomatis bila database kosong (true/false)
SEED_DEMO_DATA=true

# ---------- Database ----------
# PostgreSQL (tabel dibuat otomatis saat pertama dipakai)
DATABASE_URL=postgresql://user:password@host:5432/okta_iga
# PG_POOL_MAX=3   # default 3 (1 di Vercel); sesuaikan dengan batas koneksi database
# PGSSL=false     # SSL aktif otomatis kecuali host localhost

# ---------- Okta Management API ----------
OKTA_ORG_URL=https://your-org.okta.com
OKTA_API_TOKEN=
# true = keputusan "Revoke" di certification langsung mencabut akses di Okta
OKTA_REMEDIATION_ENABLED=false
# Interval sinkronisasi otomatis dalam jam (0 = nonaktif)
OKTA_SYNC_INTERVAL_HOURS=6

# ---------- Okta SSO (OIDC, opsional) ----------
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# ---------- Email (SMTP) ----------
# Default = Mailpit lokal (testing, email TIDAK keluar; lihat http://localhost:8025).
# Contoh SMTP asli:
#   Google Workspace / Gmail : SMTP_HOST=smtp.gmail.com      SMTP_PORT=587 SMTP_SECURE=false  (SMTP_PASS = App Password 16 karakter)
#   Microsoft 365 / Outlook  : SMTP_HOST=smtp.office365.com  SMTP_PORT=587 SMTP_SECURE=false  (SMTP AUTH harus aktif untuk mailbox)
#   SendGrid                 : SMTP_HOST=smtp.sendgrid.net   SMTP_PORT=587 SMTP_USER=apikey   SMTP_PASS=<API key>
#   Port 465 (SSL langsung)  : SMTP_SECURE=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Gmail/M365: alamat From harus sama dengan SMTP_USER (atau alias yang diizinkan)
SMTP_FROM="IGA Platform <iga@company.local>"

# ---------- Slack ----------
# Incoming Webhook (pesan teks): Slack App › Incoming Webhooks › Add New Webhook to Workspace
SLACK_WEBHOOK_URL=
SLACK_BUSINESS_OWNER_WEBHOOK_URL=
# Opsional — kirim file report (PDF/XLSX/CSV) ke channel. Webhook tidak bisa membawa file.
# Bot User OAuth Token (xoxb-…) dengan scope chat:write + files:write; undang bot ke channel: /invite @NamaApp
SLACK_BOT_TOKEN=
# Channel ID (klik nama channel › About › Channel ID, contoh C0123456789)
SLACK_CHANNEL_ID=
# Kosong = pakai SLACK_CHANNEL_ID
SLACK_BUSINESS_OWNER_CHANNEL_ID=
